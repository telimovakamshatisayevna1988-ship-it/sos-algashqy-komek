<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <rect width="512" height="512" fill="#c62828"/>
  <circle cx="256" cy="256" r="170" fill="#ffffff"/>
  <rect x="226" y="136" width="60" height="240" rx="12" fill="#c62828"/>
  <rect x="136" y="226" width="240" height="60" rx="12" fill="#c62828"/>
</svg>
<!DOCTYPE html>
<html lang="kk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#c62828">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="icon.svg">
<title>SOS Көмек</title>
<style>
:root{
  --bg:#f6f7f9; --card:#fff; --text:#1b1f24; --muted:#5b6670; --line:#e3e6ea;
  --red:#c62828; --red2:#e53935; --amber:#f9a825; --green:#2e7d32; --blue:#1565c0;
  --fs:16px;
}
:root[data-theme="dark"]{
  --bg:#0f1317; --card:#1a2027; --text:#eef1f4; --muted:#9aa6b2; --line:#2a323b;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{font-size:16px;font-size:var(--fs)}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:#f6f7f9;background:var(--bg);color:#1b1f24;color:var(--text);line-height:1.5;padding-bottom:84px}
header{background:#c62828;background:var(--red);color:#fff;padding:14px 16px;padding-top:calc(14px + env(safe-area-inset-top));display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:5}
header h1{font-size:1.15rem;margin:0}
header .tools button{background:rgba(255,255,255,.18);color:#fff;border:0;border-radius:10px;padding:8px 10px;font-size:1rem;margin-left:6px}
main{max-width:640px;margin:0 auto;padding:16px}
.screen{display:none}.screen.active{display:block}
nav{position:fixed;bottom:0;left:0;right:0;background:#fff;background:var(--card);border-top:1px solid #e3e6ea;border-top:1px solid var(--line);display:flex;padding-bottom:env(safe-area-inset-bottom);z-index:5}
nav button{flex:1;background:none;border:0;padding:10px 4px;color:#5b6670;color:var(--muted);font-size:.78rem}
nav button .i{display:block;font-size:1.35rem}
nav button.active{color:#c62828;color:var(--red);font-weight:700}
.sos-wrap{text-align:center;margin:10px 0 18px}
.sos{width:210px;height:210px;border-radius:50%;border:0;background:radial-gradient(circle at 35% 30%,#e53935,#c62828);background:radial-gradient(circle at 35% 30%,var(--red2),var(--red));color:#fff;font-size:3rem;font-weight:800;letter-spacing:2px;box-shadow:0 0 0 10px rgba(198,40,40,.15),0 10px 30px rgba(198,40,40,.4);animation:pulse 2s infinite}
.sos small{display:block;font-size:.8rem;font-weight:500;letter-spacing:0;margin-top:4px;opacity:.9}
@keyframes pulse{0%,100%{box-shadow:0 0 0 10px rgba(198,40,40,.15),0 10px 30px rgba(198,40,40,.4)}50%{box-shadow:0 0 0 22px rgba(198,40,40,.06),0 10px 30px rgba(198,40,40,.4)}}
.card{background:#fff;background:var(--card);border:1px solid #e3e6ea;border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px}
.card h2{margin:0 0 8px;font-size:1.05rem}
.btn{display:block;width:100%;text-align:center;text-decoration:none;border:0;border-radius:12px;padding:13px;font-size:1rem;font-weight:600;margin-top:8px;color:#fff;background:#1565c0;background:var(--blue)}
.btn.red{background:#c62828;background:var(--red)}.btn.green{background:#2e7d32;background:var(--green)}.btn.gray{background:#5b6670;background:var(--muted)}
.grid{display:flex;flex-wrap:wrap;margin:-4px}.grid>.num{width:calc(50% - 8px);margin:4px}
.num{display:block;text-decoration:none;color:#1b1f24;color:var(--text);background:#fff;background:var(--card);border:1px solid #e3e6ea;border:1px solid var(--line);border-radius:14px;padding:12px;text-align:center}
.num b{display:block;font-size:1.6rem;color:#c62828;color:var(--red)}
.num span{font-size:.82rem;color:#5b6670;color:var(--muted)}
.muted{color:#5b6670;color:var(--muted);font-size:.88rem}
input[type=text],input[type=tel],input[type=search]{width:100%;padding:12px;border:1px solid #e3e6ea;border:1px solid var(--line);border-radius:12px;background:#fff;background:var(--card);color:#1b1f24;color:var(--text);font-size:1rem;margin-top:6px}
.chips{display:flex;gap:6px;overflow-x:auto;padding:4px 0 10px}
.chip{flex:none;border:1px solid #e3e6ea;border:1px solid var(--line);background:#fff;background:var(--card);color:#1b1f24;color:var(--text);border-radius:999px;padding:7px 13px;font-size:.88rem}
.chip.on{background:#1b1f24;background:var(--text);color:#f6f7f9;color:var(--bg)}
.item{display:flex;align-items:center;gap:12px;width:100%;text-align:left;background:#fff;background:var(--card);border:1px solid #e3e6ea;border:1px solid var(--line);border-radius:14px;padding:13px;margin-bottom:8px;color:#1b1f24;color:var(--text);font-size:1rem}
.item .e{font-size:1.6rem}
.item .t{flex:1;font-weight:600}
.tag{font-size:.7rem;border-radius:999px;padding:3px 8px;color:#fff}
.u-r{background:#c62828;background:var(--red)}.u-y{background:#b8860b}.u-g{background:#2e7d32;background:var(--green)}
.back{background:none;border:0;color:#1565c0;color:var(--blue);font-size:1rem;padding:6px 0;margin-bottom:6px}
.sec{border-left:5px solid #e3e6ea;border-left:5px solid var(--line);padding:2px 0 2px 12px;margin:14px 0}
.sec h3{margin:0 0 4px;font-size:1rem}
.sec ol,.sec ul{margin:4px 0;padding-left:20px}
.sec li{margin:5px 0}
.sec.do{border-color:#2e7d32;border-color:var(--green)}.sec.dont{border-color:#c62828;border-color:var(--red)}.sec.call{border-color:#f9a825;border-color:var(--amber)}.sec.sym{border-color:#1565c0;border-color:var(--blue)}
.warn{font-size:.82rem;color:#5b6670;color:var(--muted);text-align:center;margin:18px 0}
.metro{text-align:center}
.beat{width:90px;height:90px;border-radius:50%;background:#c62828;background:var(--red);margin:12px auto;transition:transform .08s}
.beat.on{transform:scale(1.25)}
.toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);background:#222;color:#fff;padding:10px 16px;border-radius:12px;font-size:.9rem;display:none;z-index:9;max-width:90%}
.contact{display:flex;gap:8px;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid #e3e6ea;border-bottom:1px solid var(--line)}
.contact button{background:none;border:0;color:#c62828;color:var(--red);font-size:1.1rem}

.item .e{margin-right:12px}.chip{margin-right:6px}.item .tag{margin-left:8px}
</style>
</head>
<body>

<header>
  <h1>🆘 SOS Көмек</h1>
  <div class="tools">
    <button id="btnTheme" aria-label="Түнгі режим">🌙</button>
    <button id="btnFont" aria-label="Қаріпті үлкейту">A+</button>
  </div>
</header>

<main>
  <!-- БАСТЫ -->
  <section id="s-home" class="screen active">
    <div class="sos-wrap">
      <button class="sos" id="btnSOS">SOS<small>басыңыз</small></button>
    </div>
    <p class="muted" style="text-align:center;margin-top:-4px">Басқанда: 1) 112-ге қоңырау, 2) орныңыз жақындарға жіберіледі.</p>

    <div class="card" id="panelSOS" style="display:none">
      <h2>🚨 Көмек шақыру</h2>
      <a class="btn red" href="tel:112">📞 112-ге қоңырау шалу</a>
      <div id="locStatus" class="muted" style="margin-top:10px">📍 Орын анықталуда…</div>
      <div id="sendBox"></div>
      <button class="btn gray" id="btnCopyLoc">📋 Орынды көшіру</button>
      <p class="muted">Қоңырау шалғанда айтыңыз: не болды, қанша адам зардап шекті, мекенжай немесе бағдар.</p>
    </div>

    <h2 style="font-size:1.05rem">Төтенше нөмірлер</h2>
    <div class="grid">
      <a class="num" href="tel:112"><b>112</b><span>Бірыңғай құтқару</span></a>
      <a class="num" href="tel:103"><b>103</b><span>Жедел жәрдем</span></a>
      <a class="num" href="tel:101"><b>101</b><span>Өрт сөндіру</span></a>
      <a class="num" href="tel:102"><b>102</b><span>Полиция</span></a>
    </div>
    <p class="warn">Бұл қосымша дәрігерді алмастырмайды. Қауіпті жағдайда әрқашан алдымен 112/103-ке қоңырау шалыңыз.</p>
  </section>

  <!-- НҰСҚАУЛЫҚ ТІЗІМІ -->
  <section id="s-guides" class="screen">
    <input type="search" id="q" placeholder="🔍 Іздеу: жану, қан кету, тұншығу…">
    <div class="chips" id="chips"></div>
    <div id="list"></div>
  </section>

  <!-- НҰСҚАУЛЫҚ ТОЛЫҚ -->
  <section id="s-detail" class="screen">
    <button class="back" id="btnBack">← Артқа</button>
    <div id="detail"></div>
  </section>

  <!-- CPR -->
  <section id="s-cpr" class="screen">
    <div class="card metro">
      <h2>❤️ Жүрекке массаж ырғағы</h2>
      <p class="muted">Кеуденің ортасын қатты әрі жылдам басыңыз: минутына 100–120 рет. Дыбыс пен діріл ырғақ береді.</p>
      <div class="beat" id="beat"></div>
      <div style="font-size:1.4rem;font-weight:700"><span id="bpm">110</span> /мин</div>
      <input type="range" id="bpmRange" min="100" max="120" value="110" style="width:80%">
      <button class="btn red" id="btnMetro">▶ Бастау</button>
      <a class="btn gray" href="tel:112">📞 Алдымен 112-ге қоңырау шалыңыз</a>
    </div>
    <div class="card">
      <h2>Қысқаша қадамдар (ересек)</h2>
      <ol>
        <li>Қауіпсіздігіңізді тексеріңіз. Адамды қатты шақырып, иығынан сілкіңіз.</li>
        <li>Жауап жоқ, тыныс жоқ немесе әдеттегідей емес болса, 112-ге қоңырау шалыңыз (спикерфонмен).</li>
        <li>Адамды қатты тегіс жерге шалқасынан жатқызыңыз.</li>
        <li>Алақаныңызды кеуде сүйегінің ортасына қойып, қолды түзу ұстап, шамамен 5–6 см тереңдікке басыңыз.</li>
        <li>Әр басудан кейін кеуде толық көтерілсін. Жедел жәрдем келгенше немесе адам өзі тыныс алғанша тоқтамаңыз.</li>
        <li>Жақын жерде дефибриллятор (AED) болса, әкелуді сұраңыз және аппараттың дауыстық нұсқауын орындаңыз.</li>
      </ol>
      <p class="muted">Қолдан тыныс беруді үйренбеген болсаңыз, тек кеудеге массаж жасаңыз.</p>
    </div>
  </section>

  <!-- ЖАҚЫНДАР -->
  <section id="s-contacts" class="screen">
    <div class="card">
      <h2>👨‍👩‍👧 Сенімді адамдар</h2>
      <p class="muted">SOS басылғанда орныңыз осы адамдарға жіберуге дайын болады. Деректер тек осы телефонда сақталады.</p>
      <div id="contactList"></div>
      <input type="text" id="cName" placeholder="Аты (мысалы: Анам)">
      <input type="tel" id="cPhone" placeholder="+7 7XX XXX XX XX">
      <button class="btn green" id="btnAddContact">➕ Қосу</button>
    </div>
    <div class="card">
      <h2>🩺 Медициналық карта</h2>
      <p class="muted">Қан тобы, аллергия, тұрақты дәрілер. Көмекшілерге көрсету үшін. Тек осы телефонда сақталады.</p>
      <input type="text" id="mBlood" placeholder="Қан тобы (мысалы: A(II) Rh+)">
      <input type="text" id="mAllergy" placeholder="Аллергия">
      <input type="text" id="mMeds" placeholder="Тұрақты қабылдайтын дәрілер">
      <button class="btn green" id="btnSaveMed">💾 Сақтау</button>
    </div>
    <div class="card">
      <h2>📲 Басқаларға бөлісу</h2>
      <p class="muted">Қосымша тегін. Сілтемені достарыңызға жіберіңіз.</p>
      <button class="btn" id="btnShare">Сілтемені бөлісу</button>
    </div>
  </section>
</main>

<nav>
  <button data-go="home" class="active"><span class="i">🆘</span>SOS</button>
  <button data-go="guides"><span class="i">📖</span>Нұсқаулық</button>
  <button data-go="cpr"><span class="i">❤️</span>CPR</button>
  <button data-go="contacts"><span class="i">👤</span>Менің</button>
</nav>

<div class="toast" id="toast"></div>

<script>
/* ============ НҰСҚАУЛЫҚ ДЕРЕКТЕРІ ============
   Жаңа жағдай қосу үшін төмендегі тізімге осындай блок қосыңыз.
   u: 'r' = шұғыл (қызыл), 'y' = маңызды (сары), 'g' = жеңіл (жасыл) */
var GUIDES = [
 {id:'cpr',e:'❤️',t:'Жүрек тоқтауы (CPR)',u:'r',
  sym:['Адам жауап бермейді','Тыныс алмайды немесе қырылдап, әдеттегідей емес тыныс алады'],
  do:['112-ге қоңырау шалыңыз (спикерфон).','Қатты тегіс жерге шалқасынан жатқызыңыз.','Кеуде ортасына минутына 100–120 рет, шамамен 5–6 см тереңдікке басыңыз ("CPR" бөлімінде ырғақ бар).','AED болса, қолданыңыз.','Жедел жәрдем келгенше тоқтамаңыз.'],
  dont:['Басуды артық ұзақ тоқтатпаңыз.','Қолдан тыныс беруді білмесеңіз, тек массаж жасаңыз.'],
  call:['Әрқашан 112/103.']},
 {id:'bleed',e:'🩸',t:'Қатты қан кету',u:'r',
